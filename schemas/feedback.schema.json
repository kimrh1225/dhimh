{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R&E Research Plan Feedback v1",
  "description": "Strict Structured Outputs-compatible feedback payload; cross-item invariants are verified in server code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "overallSummary", "criteria", "globalQuestions", "caveats"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "overallSummary": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "severity", "evidenceField", "evidenceQuote", "rationale", "suggestion", "criticalQuestion", "uncertainty"],
        "properties": {
          "id": { "type": "string", "enum": ["question_clarity", "hypothesis_fit", "method_fit", "variables_controls", "feasibility", "interpretability"] },
          "status": { "type": "string", "enum": ["adequate", "needs_revision", "insufficient_information", "not_applicable"] },
          "severity": { "type": "string", "enum": ["none", "low", "medium", "high"] },
          "evidenceField": { "type": "string", "enum": ["none", "title", "researchQuestion", "hypothesis", "methods", "independentVariables", "dependentVariables", "controls", "expectedResults", "resourcesAndTimeline"] },
          "evidenceQuote": { "type": "string" },
          "rationale": { "type": "string" },
          "suggestion": { "type": "string" },
          "criticalQuestion": { "type": "string" },
          "uncertainty": { "type": "string" }
        }
      }
    },
    "globalQuestions": { "type": "array", "items": { "type": "string" } },
    "caveats": { "type": "array", "items": { "type": "string" } }
  }
}
